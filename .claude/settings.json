{
  "permissions": {
    "deny": [
      "Write(.env)",
      "Edit(.env)",
      "Read(.env)",
      "Write(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env)",
      "Write(.env.local)",
      "Write(.env.production)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/log-prompt.js"
          }
        ]
      }
    ]
  }
}
